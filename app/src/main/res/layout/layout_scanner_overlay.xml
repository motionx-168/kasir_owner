<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.digitalwhy.kasir.ScannerOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/circle_transparent"
            android:backgroundTint="@color/bg_surface"
            android:contentDescription="Menu"
            android:padding="12dp"
            android:src="@drawable/ic_menu" />

        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/circle_transparent"
            android:backgroundTint="@color/bg_surface"
            android:contentDescription="Flash"
            android:padding="12dp"
            android:src="@drawable/ic_flash" />

        <ImageButton
            android:id="@+id/flipButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_transparent"
            android:backgroundTint="@color/bg_surface"
            android:contentDescription="Flip camera"
            android:padding="12dp"
            android:src="@drawable/ic_flip" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/scanFrameContainer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/scannerFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Scan frame"
                android:src="@drawable/scanner_frame" />

            <ImageView
                android:id="@+id/laserLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Laser line"
                android:scaleType="fitXY"
                android:src="@drawable/laser_line" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/scanFrameContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:text="Arahkan barcode ke dalam kotak"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/total_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Belanja"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rp 0"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBayar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/button_gradient"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="BAYAR"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</FrameLayout>
