<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dw_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <!-- TOP HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Text.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Owner 👋"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lucide_bell"
                    app:layout_constraintBottom_toBottomOf="@id/tvGreeting"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvGreeting" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- HERO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_gradient"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hari ini"
                        android:alpha="0.7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/Text.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:layout_marginBottom="20dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lucide_wallet"
                            app:tint="@color/dw_text_primary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dw_text_primary"
                            android:textSize="14sp"
                            android:text="Omzet Hari Ini" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfit"
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textSize="40sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvSubInfo"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:textSize="13sp"
                        android:text="Belum ada transaksi hari ini."
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BENTO GRID -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="16dp">

                <!-- Stok Menipis -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/dw_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/ic_lucide_box" android:layout_marginEnd="6dp" />
                            <TextView style="@style/Text.Label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Stok Menipis" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvLowStock" style="@style/Text.Header"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 Item" android:textColor="#FB923C"
                            android:textSize="20sp" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hampir Expired -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/dw_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/ic_lucide_calendar" android:layout_marginEnd="6dp" />
                            <TextView style="@style/Text.Label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Hampir Expired" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvExpired" style="@style/Text.Header"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 Item" android:textColor="#FB7185"
                            android:textSize="20sp" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- ACTION BUTTONS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnManageProducts"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/dw_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="#33FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_lucide_box"
                                app:tint="@color/dw_teal"
                                android:layout_marginEnd="6dp" />
                            <TextView
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/dw_text_primary"
                                android:text="Stok" />
                        </LinearLayout>
                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dw_text_secondary"
                            android:textSize="12sp"
                            android:text="Tambah / Ubah"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLaporan"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/dw_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="#33FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="top"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_lucide_chart"
                                app:tint="@color/dw_text_primary"
                                android:layout_marginEnd="6dp" />
                            <TextView
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/dw_text_primary"
                                android:text="Lihat Laporan" />
                        </LinearLayout>
                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dw_text_secondary"
                            android:textSize="12sp"
                            android:text="Omzet &amp; Laba"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- GRAFIK TREN -->
            <TextView
                style="@style/Text.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tren Omzet"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartDashboard"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#1E293B"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/dw_teal"
        app:itemTextColor="@color/dw_text_secondary"
        app:menu="@menu/bottom_nav_menu" />

    <!-- FAB SCAN (MELAYANG DI ATAS NAV BAR) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:src="@drawable/ic_lucide_scan"
        app:backgroundTint="@color/dw_teal"
        app:tint="#FFFFFF"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
