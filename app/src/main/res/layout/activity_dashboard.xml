<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dw_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <!-- TOP HEADER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <!-- Memanggil class Text.Header -->
            <TextView
                android:id="@+id/tvGreeting"
                style="@style/Text.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo, Owner 👋"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lucide_bell"
                app:layout_constraintBottom_toBottomOf="@id/tvGreeting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvGreeting" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- HERO CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hari ini"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Text.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="Kamis, 5 November 2026"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_wallet"
                        app:tint="@color/dw_text_primary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dw_text_primary"
                        android:text="Laba Hari Ini" />
                </LinearLayout>

                <!-- Memanggil class Text.Display -->
                <TextView
                    android:id="@+id/tvProfit"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvSubInfo"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Belum ada transaksi hari ini."
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BENTO GRID -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/dw_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155" app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_lucide_box" android:layout_marginEnd="6dp" />
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Stok Menipis" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvLowStock" style="@style/Text.Header"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 Item" android:textColor="#FB923C"
                        android:textSize="22sp" android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/dw_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#334155" app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_lucide_calendar" android:layout_marginEnd="6dp" />
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Hampir Expired" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvExpired" style="@style/Text.Header"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 Item" android:textColor="#FB7185"
                        android:textSize="22sp" android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageProducts"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Kelola Produk"
                android:textColor="@color/dw_text_primary"
                android:textSize="14sp" android:textStyle="bold"
                app:backgroundTint="@color/dw_teal"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_lucide_box"
                app:iconTint="@color/dw_text_primary"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Laporan"
                android:textColor="@color/dw_text_primary"
                android:textSize="14sp" android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#475569"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_lucide_chart"
                app:iconTint="@color/dw_text_primary"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
