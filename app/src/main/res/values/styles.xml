<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HEADER: Untuk Sapaan & Tanggal -->
    <style name="Text.Header" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- DISPLAY: Untuk Angka Laba (Rp 0) -->
    <style name="Text.Display" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">42sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- LABEL: Untuk Judul Card (Stok Menipis, dll) -->
    <style name="Text.Label" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- BODY: Untuk Teks Biasa -->
    <style name="Text.Body" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.DigitalWhy.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1A00BFA5</item>
    </style>

    <style name="Theme.DigitalWhy.DatePicker" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">@color/dw_teal</item>
        <item name="colorOnPrimary">@color/bg_main</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorAccent">@color/dw_teal</item>
        <item name="android:colorAccent">@color/dw_teal</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_surface</item>
    </style>
</resources>
